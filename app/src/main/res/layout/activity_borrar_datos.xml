<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".adapter.in.ui.configuracion.BorrarDatosActivity"
    tools:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/volver"
        app:navigationIcon="@drawable/ic_volver"
        app:title="@string/borrar_titulo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="600dp"
            android:text="@string/borrar_explicacion"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Se eliminarán tu perfil, tus ajustes y todos tus datos de este teléfono. No se puede deshacer." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/borrar_alcance"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <RadioGroup
            android:id="@+id/grupoAlcance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/alcanceTelefono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/borrar_alcance_telefono" />

            <RadioButton
                android:id="@+id/alcanceDrive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/borrar_alcance_drive" />

            <RadioButton
                android:id="@+id/alcanceAmbos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/borrar_alcance_ambos" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonBorrarTelefono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="@dimen/button_height"
            android:text="@string/borrar_accion" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp"
    tools:context=".adapter.in.ui.MateriasActivity"
    tools:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/colorMateria"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_circulo"
        tools:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nombreMateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="600dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Matemáticas" />

        <TextView
            android:id="@+id/docenteMateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="600dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Dra. Ruiz" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barraMetaMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/materia_meta_progreso_cd"
            android:max="100"
            android:maxWidth="600dp"
            android:visibility="gone"
            tools:progress="75"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textoMetaMateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxWidth="600dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            tools:text="3 / 4 h"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/horasMateria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:maxWidth="600dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="0 h" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".adapter.in.ui.EstadisticasActivity"
    tools:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraEstadisticas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/estadisticas_titulo" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoPeriodoEstadisticas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        app:checkedButton="@id/btnPeriodoSemana"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraEstadisticas"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeriodoSemana"
            style="@style/Widget.StudyPlan.Button.Toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="@string/estadisticas_semana" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeriodoMes"
            style="@style/Widget.StudyPlan.Button.Toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="@string/estadisticas_mes" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPeriodoAnteriorEstadisticas"
        style="@style/Widget.StudyPlan.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/estadisticas_anterior"
        android:minWidth="48dp"
        android:minHeight="@dimen/button_height"
        app:icon="@drawable/ic_chevron_izq"
        app:layout_constraintBottom_toBottomOf="@id/textoRangoEstadisticas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textoRangoEstadisticas" />

    <TextView
        android:id="@+id/textoRangoEstadisticas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:layout_constraintEnd_toStartOf="@id/btnPeriodoSiguienteEstadisticas"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@id/btnPeriodoAnteriorEstadisticas"
        app:layout_constraintTop_toBottomOf="@id/grupoPeriodoEstadisticas"
        app:layout_constraintWidth_max="600dp"
        tools:text="16 nov - 22 nov 2026" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPeriodoSiguienteEstadisticas"
        style="@style/Widget.StudyPlan.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/estadisticas_siguiente"
        android:minWidth="48dp"
        android:minHeight="@dimen/button_height"
        app:icon="@drawable/ic_chevron_der"
        app:layout_constraintBottom_toBottomOf="@id/textoRangoEstadisticas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textoRangoEstadisticas" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoSubvistaEstadisticas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:checkedButton="@id/btnSubvistaResumen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoRangoEstadisticas"
        app:layout_constraintWidth_max="600dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubvistaResumen"
            style="@style/Widget.StudyPlan.Button.Toggle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="@string/estadisticas_resumen" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubvistaConcentracion"
            style="@style/Widget.StudyPlan.Button.Toggle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="@string/estadisticas_concentracion" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollEstadisticas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/grupoSubvistaEstadisticas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/contenedorResumenEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.StudyPlan.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textoTotalHorasEstadisticas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            tools:text="4.5 h estudiadas" />

                        <TextView
                            android:id="@+id/textoVariacionEstadisticas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="↑ 25 % respecto a la semana anterior" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.StudyPlan.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/estadisticas_distribucion_titulo"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.github.mikephil.charting.charts.PieChart
                            android:id="@+id/graficoDistribucionMaterias"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="12dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/textoSinHorasEstadisticas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxWidth="600dp"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:text="@string/estadisticas_sin_horas"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            app:drawableStartCompat="@drawable/ic_estadisticas"
                            app:drawableTint="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/listaDistribucionMaterias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.StudyPlan.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/estadisticas_cumplimiento_titulo"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/textoCumplimientoValor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            tools:text="80 % de cumplimiento" />

                        <TextView
                            android:id="@+id/textoCumplimientoDesglose"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="3 completadas · 1 tardías · 1 no realizadas · 0 reprogramadas" />

                        <TextView
                            android:id="@+id/textoPendientesAviso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"
                            tools:text="2 pendientes o futuras aún no cuentan en la tasa"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonAbrirReportes"
                    style="@style/Widget.StudyPlan.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/accion_ver_reportes" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorConcentracionEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.StudyPlan.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/estadisticas_indice_concentracion"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/textoIndiceConcentracion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            tools:text="92 %" />

                        <TextView
                            android:id="@+id/textoInterrupciones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="Interrupciones: 1 (0.5 / hora)" />

                        <TextView
                            android:id="@+id/textoPuntualidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="Puntualidad media: 2.0 min respecto al plan" />

                        <TextView
                            android:id="@+id/textoRespetoTiempo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="Respeto del tiempo planificado: 95 %" />

                        <TextView
                            android:id="@+id/textoTiempoFuera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="Tiempo fuera de la app: 5 min" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.StudyPlan.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/estadisticas_estudio_externo_titulo"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/textoEstudioExternoResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="15 min fuera de la app (5 min sin clasificar)" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/listaEstudioExternoTopicos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.StudyPlan.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/estadisticas_topicos_titulo"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <TextView
                            android:id="@+id/textoSinTopicos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:maxWidth="600dp"
                            android:text="@string/estadisticas_sin_topicos"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/listaTopicosInterrupcion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

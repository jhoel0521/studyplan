<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp"
    tools:context=".adapter.in.ui.MainActivity"
    tools:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/colorSelectorMateria"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_circulo"
        tools:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/nombreSelectorMateria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxWidth="600dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        tools:text="Matemáticas" />
</LinearLayout>

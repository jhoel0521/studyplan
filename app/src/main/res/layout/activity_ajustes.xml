<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".adapter.in.ui.AjustesActivity"
    tools:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/volver"
        app:navigationIcon="@drawable/ic_volver"
        app:title="@string/ajustes_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="600dp"
                android:text="@string/ajustes_tema"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Tema" />

            <RadioGroup
                android:id="@+id/grupoTema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/temaSistema"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/tema_sistema" />

                <RadioButton
                    android:id="@+id/temaClaro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/tema_claro" />

                <RadioButton
                    android:id="@+id/temaOscuro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/tema_oscuro" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:maxWidth="600dp"
                android:text="@string/ajustes_idioma"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Idioma" />

            <RadioGroup
                android:id="@+id/grupoIdioma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/idiomaEspanol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/idioma_espanol" />

                <RadioButton
                    android:id="@+id/idiomaIngles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/idioma_ingles" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:maxWidth="600dp"
                android:text="@string/ajustes_seguridad"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Seguridad" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/interruptorBloqueo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ajustes_bloqueo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:maxWidth="600dp"
                android:text="@string/ajustes_tecnicas_titulo"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Técnicas de estudio" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/interruptorNoMolestarGlobal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/ajustes_no_molestar_global" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:hint="@string/ajustes_pomodoro_trabajo"
                android:maxWidth="400dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoPomodoroTrabajo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxWidth="400dp"
                    android:minHeight="48dp"
                    tools:text="25" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:hint="@string/ajustes_pomodoro_corto"
                android:maxWidth="400dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoPomodoroCorto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxWidth="400dp"
                    android:minHeight="48dp"
                    tools:text="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:hint="@string/ajustes_pomodoro_largo"
                android:maxWidth="400dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoPomodoroLargo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxWidth="400dp"
                    android:minHeight="48dp"
                    tools:text="15" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:hint="@string/ajustes_pomodoro_ciclos"
                android:maxWidth="400dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoPomodoroCiclos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxWidth="400dp"
                    android:minHeight="48dp"
                    tools:text="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textoErrorPomodoro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="600dp"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:text="Revisa los rangos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGuardarPomodoro"
                style="@style/Widget.StudyPlan.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="@dimen/button_height"
                android:text="@string/ajustes_pomodoro_guardar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:maxWidth="600dp"
                android:text="@string/ajustes_seccion_recordatorios"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Recordatorios de sesiones" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/grupoRecordatorioDefecto"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="12dp"
                android:hint="@string/ajustes_recordatorio_por_defecto"
                android:maxWidth="400dp"
                app:helperText="@string/ajustes_recordatorio_nota"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/selectorRecordatorioDefecto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxWidth="400dp"
                    android:minHeight="48dp"
                    tools:text="15 minutos antes" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/contenedorPermisoNotificaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textoPermisoNotificacionesFalta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="600dp"
                    android:text="@string/ajustes_permiso_notificaciones_falta"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorError"
                    tools:text="Las notificaciones están desactivadas." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonAbrirAjustesNotificaciones"
                    style="@style/Widget.StudyPlan.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/ajustes_permiso_notificaciones_ir" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorPermisoAlarmas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/textoPermisoAlarmasFalta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="600dp"
                    android:text="@string/ajustes_permiso_alarmas_falta"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorError"
                    tools:text="Los avisos puntuales están limitados." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonAbrirAjustesAlarmas"
                    style="@style/Widget.StudyPlan.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/ajustes_permiso_alarmas_ir" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonPrivacidad"
                style="@style/Widget.StudyPlan.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="@dimen/button_height"
                android:text="@string/ajustes_privacidad" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

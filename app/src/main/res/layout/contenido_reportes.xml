<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".adapter.in.ui.ReportesActivity"
    tools:fitsSystemWindows="true">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/grupoPeriodoReportes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        app:checkedButton="@id/btnPeriodoSemanaReportes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeriodoSemanaReportes"
            style="@style/Widget.StudyPlan.Button.Toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="@string/estadisticas_semana" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPeriodoMesReportes"
            style="@style/Widget.StudyPlan.Button.Toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="@string/estadisticas_mes" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPeriodoAnteriorReportes"
        style="@style/Widget.StudyPlan.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/estadisticas_anterior"
        android:minWidth="48dp"
        android:minHeight="@dimen/button_height"
        app:icon="@drawable/ic_chevron_izq"
        app:layout_constraintBottom_toBottomOf="@id/textoRangoReportes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textoRangoReportes" />

    <TextView
        android:id="@+id/textoRangoReportes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        app:layout_constraintEnd_toStartOf="@id/btnPeriodoSiguienteReportes"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@id/btnPeriodoAnteriorReportes"
        app:layout_constraintTop_toBottomOf="@id/grupoPeriodoReportes"
        app:layout_constraintWidth_max="600dp"
        tools:text="2026-11-16 – 2026-11-22" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPeriodoSiguienteReportes"
        style="@style/Widget.StudyPlan.Button.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/estadisticas_siguiente"
        android:minWidth="48dp"
        android:minHeight="@dimen/button_height"
        app:icon="@drawable/ic_chevron_der"
        app:layout_constraintBottom_toBottomOf="@id/textoRangoReportes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/textoRangoReportes" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoRangoReportes">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StudyPlan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/reportes_planificadas_titulo"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/textoTotalPlanificadasReportes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            tools:text="6.0 h" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/reportes_reales_titulo"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/textoTotalRealesReportes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            tools:text="4.5 h" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/reportes_cumplimiento_titulo"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/textoTotalCumplimientoReportes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            tools:text="75 %" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/reportes_no_realizadas_titulo"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/textoTotalNoRealizadasReportes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            tools:text="1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="botonExportarPdf,botonExportarCsv"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="12dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="8dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonExportarPdf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/reportes_exportar_pdf" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonExportarCsv"
                    style="@style/Widget.StudyPlan.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/reportes_exportar_csv" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textoSinDatosReportes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:maxWidth="600dp"
                android:text="@string/reportes_sin_datos"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Sin datos registrados ni planificados en este periodo"
                tools:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaMateriasReportes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

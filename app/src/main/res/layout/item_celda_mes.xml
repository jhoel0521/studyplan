<?xml version="1.0" encoding="utf-8"?>
<!-- Celda de cuadrícula 7 columnas (excepción explícita de AGENTS.md §6.2 para 5" RNF-19). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tarjetaCeldaMes"
    style="@style/Widget.Material3.CardView.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp"
    app:cardCornerRadius="8dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/textoNumeroDiaMes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="600dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            tools:text="16" />

        <LinearLayout
            android:id="@+id/contenedorPuntosColorMes"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/textoHorasDiaMes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:maxWidth="600dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="2.0 h" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

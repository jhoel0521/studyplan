<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".adapter.in.ui.RepartoSesionActivity"
    tools:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_volver"
        app:title="@string/reparto_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sesión que se cruzó con el tramo (W14): barra del color de la materia y nombre. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaSesionCruzadaReparto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barraSesionCruzadaReparto"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/fondo_barra_materia"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="600dp"
                            android:text="@string/reparto_sesion_cruzada"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Tu sesión siguiente se cruzó:" />

                        <TextView
                            android:id="@+id/nombreSesionCruzadaReparto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxWidth="600dp"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            tools:text="Inglés" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:maxWidth="600dp"
                android:text="@string/reparto_repartir_tiempo"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Repartir el tiempo" />

            <!-- Barra de reparto de 36 dp con esquinas de 14 dp; cada tramo lleva el color ajustado de su materia. -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="@dimen/radius_button"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barraPrimeraReparto"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        tools:background="#1565C0" />

                    <View
                        android:id="@+id/barraSegundaReparto"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        tools:background="#2E7D32" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tiempo de cada materia en un chip con su color al 15 %; el texto va en colorOnSurface. -->
            <LinearLayout
                android:id="@+id/textoResumenReparto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPrimeraReparto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_chip_materia"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Matemáticas: 65 min" />

                <TextView
                    android:id="@+id/chipSegundaReparto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/fondo_chip_materia"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Inglés: 65 min" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoHoraCorteReparto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="600dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Hora de corte: 11:05" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCorteReparto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/reparto_titulo"
                android:stepSize="5.0"
                android:valueFrom="0.0"
                android:valueTo="100.0" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonMenos5Min"
                    style="@style/Widget.StudyPlan.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/reparto_menos_5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonMas5Min"
                    style="@style/Widget.StudyPlan.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/reparto_mas_5" />

                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="botonMenos5Min,botonMas5Min"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="8dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalGap="8dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textoErrorReparto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxWidth="600dp"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:text="Error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonConfirmarReparto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="@dimen/button_height"
                android:text="@string/reparto_confirmar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

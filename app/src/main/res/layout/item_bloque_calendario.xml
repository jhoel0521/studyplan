<?xml version="1.0" encoding="utf-8"?>
<!-- Bloque horario proporcional en Semana/Día (excepción AGENTS.md §6.2 para bloques proporcionales). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tarjetaBloqueCalendario"
    style="@style/Widget.StudyPlan.Card.Compact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <View
            android:id="@+id/franjaColorBloque"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            tools:background="#1565C0" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/textoMateriaBloque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="600dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textStyle="bold"
                tools:text="Cálculo" />

            <TextView
                android:id="@+id/textoHorarioBloque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="600dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:visibility="gone"
                tools:text="09:00 – 10:30"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconoEstadoBloque"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    tools:src="@drawable/ic_estado_pendiente"
                    tools:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/textoEstadoBloque"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="600dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    tools:text="Pendiente" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

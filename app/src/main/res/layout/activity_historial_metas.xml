<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".adapter.in.ui.HistorialMetasActivity"
    tools:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/volver"
        app:navigationIcon="@drawable/ic_volver"
        app:title="@string/titulo_historial_metas" />

    <TextView
        android:id="@+id/estadoVacioHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:maxWidth="600dp"
        android:text="@string/historial_metas_vacio"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone"
        tools:text="Aún no hay semanas registradas en el historial" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaHistorialMetas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />
</LinearLayout>

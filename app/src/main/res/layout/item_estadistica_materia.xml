<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp"
    tools:context=".adapter.in.ui.EstadisticasActivity">

    <ImageView
        android:id="@+id/indicadorColorMateriaEstadistica"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_circulo"
        tools:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/textoNombreMateriaEstadistica"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="Cálculo diferencial" />

    <TextView
        android:id="@+id/textoDetalleMateriaEstadistica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxWidth="600dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="1.5 h · 60%" />
</LinearLayout>

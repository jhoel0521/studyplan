<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".adapter.in.ui.MainActivity"
    tools:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tituloSelectorEstudio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="600dp"
            android:text="@string/selector_estudio_titulo"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:text="¿Qué vas a estudiar?" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxWidth="600dp"
            android:text="@string/sesion_detalle_tecnica"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Técnica de estudio" />

        <!-- Libre / Pomodoro como grupo de botones alternables (design.md, decisión 2). -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoTecnicaSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/opcionTecnicaLibre"
                style="@style/Widget.StudyPlan.Button.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:minHeight="@dimen/button_height"
                android:text="@string/sesion_tecnica_libre" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/opcionTecnicaPomodoro"
                style="@style/Widget.StudyPlan.Button.Toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="@string/sesion_tecnica_pomodoro" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:id="@+id/contenedorListaMateriasSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonMostrarNuevaMateria"
            style="@style/Widget.StudyPlan.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="@dimen/button_height"
            android:text="@string/selector_nueva_materia"
            app:icon="@drawable/ic_agregar" />

        <!-- La sesión empieza solo con «Comenzar», desactivado hasta elegir una materia (HU-47, decisión 20). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonComenzarSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:minHeight="@dimen/button_height"
            android:text="@string/selector_comenzar"
            app:icon="@drawable/ic_reproducir" />

        <LinearLayout
            android:id="@+id/panelNuevaMateriaSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contenedorNombreNuevaMateria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:hint="@string/selector_nueva_materia_nombre"
                android:maxWidth="400dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoNombreNuevaMateria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxWidth="400dp"
                    android:minHeight="48dp"
                    tools:text="Biología" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonComenzarNuevaMateria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="@dimen/button_height"
                android:text="@string/selector_iniciar_estudio" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

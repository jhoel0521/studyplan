<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingVertical="8dp"
    tools:context=".adapter.in.ui.ReportesActivity">

    <ImageView
        android:id="@+id/indicadorColorMateriaReporte"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_circulo"
        app:layout_constraintBottom_toBottomOf="@id/textoNombreMateriaReporte"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/textoNombreMateriaReporte"
        tools:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/textoNombreMateriaReporte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/indicadorColorMateriaReporte"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="600dp"
        tools:text="Cálculo diferencial" />

    <TextView
        android:id="@+id/textoResumenMateriaReporte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/textoNombreMateriaReporte"
        app:layout_constraintTop_toBottomOf="@id/textoNombreMateriaReporte"
        app:layout_constraintWidth_max="600dp"
        tools:text="Plan: 2.0 h · Real: 1.5 h · Cumpl.: 75 % · No real.: 1" />
</androidx.constraintlayout.widget.ConstraintLayout>

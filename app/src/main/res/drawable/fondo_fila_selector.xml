<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del selector «Estudiar ahora»: la materia elegida (activated) en colorPrimaryContainer con radio de 14 dp.
     Implementa: HU-47 (escenario «Materia elegida visible»), decisión 20. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_button" />
            <solid android:color="?attr/colorPrimaryContainer" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_button" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>

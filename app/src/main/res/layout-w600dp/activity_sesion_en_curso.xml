<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".adapter.in.ui.SesionEnCursoActivity"
    tools:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_volver"
        app:title="@string/sesion_en_curso_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/colorMateriaEnCurso"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_circulo"
                    tools:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/nombreMateriaEnCurso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:maxWidth="600dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Cálculo" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoFasePomodoro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxWidth="600dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Trabajo · Ciclo 1/4"
                tools:visibility="visible" />

            <!-- Anillo de progreso de la fase con el cronómetro dentro (design.md, decisión 5b). Su color lo pone
                 SesionEnCursoActivity según la fase: colorPrimary, colorWarning o colorSecondary. -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginTop="16dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/anilloProgresoEnCurso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:contentDescription="@string/sesion_en_curso_progreso_fase"
                    android:max="1000"
                    android:progress="1000"
                    app:indicatorColor="?attr/colorPrimary"
                    app:indicatorSize="220dp"
                    app:trackColor="@color/sp_ring_track"
                    app:trackCornerRadius="7dp"
                    app:trackThickness="14dp" />

                <LinearLayout
                    android:layout_width="176dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textoCronometro"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceDisplayMedium"
                        app:autoSizeMaxTextSize="56sp"
                        app:autoSizeMinTextSize="24sp"
                        app:autoSizeStepGranularity="2sp"
                        app:autoSizeTextType="uniform"
                        tools:text="18:42" />

                    <TextView
                        android:id="@+id/textoEstadoEnCurso"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxWidth="600dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorPrimary"
                        tools:text="Estudiando" />

                    <!-- Candado dentro del cronómetro: bloquea la pantalla y cuenta como estudio (HU-50). -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonBloquear"
                        style="@style/Widget.StudyPlan.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/bloqueo_pantalla_boton"
                        app:icon="@drawable/ic_candado"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Aviso: los controles de la notificación están desactivados porque se denegó el permiso (HU-49, RNF-18). -->
            <LinearLayout
                android:id="@+id/avisoNotificacionesDesactivadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxWidth="600dp"
                    android:text="@string/sesion_en_curso_notificaciones_desactivadas"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonAjustesNotificacionesSesion"
                    style="@style/Widget.StudyPlan.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/ajustes_permiso_notificaciones_ir" />
            </LinearLayout>

            <!-- Controles estilo reproductor (HU-03, HU-24): Pausar/Reanudar es un botón redondo de 64 dp, la única
                 excepción a la altura común de los botones; el resto son iconos de 48 dp con su etiqueta. Bajan de
                 línea con la fuente grande. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/controlDetener"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonDetenerEnCurso"
                        style="@style/Widget.StudyPlan.Button.Icon.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/sesion_en_curso_detener"
                        app:icon="@drawable/ic_detener"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/sesion_en_curso_detener"
                        android:textAppearance="?attr/textAppearanceLabelSmall" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controlCambiarMateria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonCambiarMateria"
                        style="@style/Widget.StudyPlan.Button.Icon.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/sesion_cambiar_materia"
                        app:icon="@drawable/ic_cambiar_materia"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <TextView
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/sesion_cambiar_materia"
                        android:textAppearance="?attr/textAppearanceLabelSmall" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controlPausarReanudar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/botonPausarReanudar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/sesion_en_curso_pausar"
                        app:backgroundTint="?attr/colorPrimary"
                        app:elevation="0dp"
                        app:fabCustomSize="64dp"
                        app:maxImageSize="32dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.StudyPlan.BotonCircular"
                        app:srcCompat="@drawable/ic_pausar"
                        app:tint="?attr/colorOnPrimary" />

                    <TextView
                        android:id="@+id/textoEtiquetaPausarReanudar"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/sesion_en_curso_pausar"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        tools:text="Pausar" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controlNoMolestar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonNoMolestar"
                        style="@style/Widget.StudyPlan.Button.Icon.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/sesion_no_molestar_boton"
                        app:icon="@drawable/ic_no_molestar_apagado"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />

                    <TextView
                        android:id="@+id/textoEtiquetaNoMolestar"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="@string/sesion_no_molestar_apagado"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        tools:text="No molestar apagado" />
                </LinearLayout>

                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="controlDetener,controlCambiarMateria,controlPausarReanudar,controlNoMolestar"
                    app:flow_horizontalGap="12dp"
                    app:flow_horizontalStyle="packed"
                    app:flow_verticalAlign="top"
                    app:flow_verticalGap="16dp"
                    app:flow_wrapMode="chain"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaExtensionPomodoro"
                style="@style/Widget.StudyPlan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="600dp"
                        android:text="@string/sesion_en_curso_extender_titulo"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonMasUnPomodoro"
                            style="@style/Widget.StudyPlan.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/sesion_en_curso_mas_pomodoro" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonTiempoExtraLibre"
                            style="@style/Widget.StudyPlan.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/sesion_en_curso_tiempo_extra_libre" />

                        <androidx.constraintlayout.helper.widget.Flow
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="botonMasUnPomodoro,botonTiempoExtraLibre"
                            app:flow_horizontalBias="0"
                            app:flow_horizontalGap="8dp"
                            app:flow_horizontalStyle="packed"
                            app:flow_verticalGap="8dp"
                            app:flow_wrapMode="chain"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaFinPlanificado"
                style="@style/Widget.StudyPlan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="600dp"
                        android:text="@string/sesion_en_curso_fin_plan_titulo"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonSigoEstudiando"
                            style="@style/Widget.StudyPlan.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/sesion_en_curso_sigo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonTermineFinPlan"
                            style="@style/Widget.StudyPlan.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/sesion_en_curso_termine" />

                        <androidx.constraintlayout.helper.widget.Flow
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="botonSigoEstudiando,botonTermineFinPlan"
                            app:flow_horizontalBias="0"
                            app:flow_horizontalGap="16dp"
                            app:flow_horizontalStyle="packed"
                            app:flow_verticalGap="16dp"
                            app:flow_wrapMode="chain"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaInvasionSesion"
                style="@style/Widget.StudyPlan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textoInvasionTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="600dp"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        tools:text="Invadiendo horario de Inglés (11:00 – 12:00)" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonCambiarSiguiente"
                            style="@style/Widget.StudyPlan.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/sesion_en_curso_cambiar_siguiente" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonRepartirTramo"
                            style="@style/Widget.StudyPlan.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/sesion_en_curso_repartir" />

                        <androidx.constraintlayout.helper.widget.Flow
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="botonCambiarSiguiente,botonRepartirTramo"
                            app:flow_horizontalBias="0"
                            app:flow_horizontalGap="8dp"
                            app:flow_horizontalStyle="packed"
                            app:flow_verticalGap="8dp"
                            app:flow_wrapMode="chain"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".adapter.in.ui.StudyPlanApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyPlan">
        <activity
            android:name=".adapter.in.ui.configuracion.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".adapter.in.ui.configuracion.PerfilInicialActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".adapter.in.ui.configuracion.AutenticacionActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".adapter.in.ui.configuracion.AjustesActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.configuracion.BorrarDatosActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.materias.MateriasActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.materias.MateriaFormularioActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".adapter.in.ui.sesiones.SesionFormularioActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".adapter.in.ui.sesiones.SesionDetalleActivity"
            android:exported="false"
            android:parentActivityName=".adapter.in.ui.configuracion.MainActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".adapter.in.ui.calendario.CalendarioActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.estadisticas.EstadisticasActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.reportes.ReportesActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.tecnicas.SesionEnCursoActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.tecnicas.RepartoSesionActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.metas.HistorialMetasActivity"
            android:exported="false" />
        <activity
            android:name=".adapter.in.ui.metas.FelicitacionMetasActivity"
            android:exported="false" />

        <receiver
            android:name=".adapter.in.ui.ReceptorAvisosSesion"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <action android:name="io.github.jhoel0521.studyplan.ACCION_HITO_SESION" />
            </intent-filter>
            <intent-filter>
                <action android:name="io.github.jhoel0521.studyplan.ACCION_RECORDATORIO_SESION" />
                <data
                    android:host="recordatorio"
                    android:scheme="studyplan" />
            </intent-filter>
        </receiver>

        <!-- Administrador del dispositivo con la única política «bloquear la pantalla» (HU-50) -->
        <receiver
            android:name=".adapter.out.system.ReceptorAdministradorBloqueo"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/politicas_bloqueo" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Sostiene la notificación de la sesión En curso con sus controles (HU-49) -->
        <service
            android:name=".adapter.in.ui.ServicioSesionEnCurso"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Cronómetro de la sesión de estudio con controles para pausar y detener" />
        </service>

        <!-- Guarda el idioma elegido en Android 12 o anterior (HU-03) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Exposición segura de reportes PDF y CSV desde caché privada (HU-33) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
